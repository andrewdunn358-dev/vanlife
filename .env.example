# Copy to .env and fill in. .env is gitignored - never commit it.

# Where the big files live. On DSM point this at a shared folder,
# e.g. /volume1/vanlife/data
DATA_DIR=./data

# Port the site is published on. Only needs changing if something else
# on the NAS already has 24721.
SITE_PORT=24721

# Cloudflare R2 - tiles are served from here, never from home broadband.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vanlife-tiles

# Public URL the viewer reads tiles from, once the bucket is wired up.
PMTILES_URL=https://tiles.example.com/signal-4g.pmtiles
