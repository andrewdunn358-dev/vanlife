# Bulk data never goes in git. Not the raw CSVs, not the intermediates,
# not the tiles. Git LFS is not the answer either - you will hit the
# quota and the bandwidth billing fast.
# Note: 'data/' would stop git descending into the directory at all, so a
# negation below it could never match. Ignore the contents instead.
data/*
*.csv

# Exception: small hand-maintained reference data belongs in version
# control. It is research, not a build artefact.
!data/authorities-priority.csv
*.geojsonl
*.pmtiles
*.mbtiles

# Secrets
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/

# OS
.DS_Store
@eaDir/
Thumbs.db
